---
import { getCollection } from 'astro:content';
import { Badge, Card, CardGrid, Code, LinkButton } from '@astrojs/starlight/components';
import { toLocale, type Localized } from '~/i18n/locales';
import { getTool, toolHref } from '~/lib/tools/registry';

const locale = toLocale(Astro.locals.starlightRoute.locale);
const base = import.meta.env.BASE_URL;
const tryTool: Localized = { en: 'Try it', es: 'Probar' };
const packages = (await getCollection('packages', ({ data }) => !data.hidden)).sort(
  (a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title),
);
---

<CardGrid>
  {packages.map(({ data }) => {
    const tool = data.tool ? getTool(data.tool) : undefined;
    return (
      <Card title={data.title}>
        <p>{data.description[locale]}</p>
        <Code code={`npm i ${data.package}`} lang="sh" />
        <div class="project-tags">
          {data.tags.map((tag) => (
            <Badge text={tag} variant="note" />
          ))}
        </div>
        <LinkButton href={data.npm} variant="minimal" icon="seti:npm">
          npm
        </LinkButton>
        {data.repo && (
          <LinkButton href={data.repo} variant="minimal" icon="github">
            Repo
          </LinkButton>
        )}
        {data.demo && (
          <LinkButton href={data.demo} variant="minimal" icon="external">
            Demo
          </LinkButton>
        )}
        {tool && (
          <LinkButton href={toolHref(base, locale, tool)} variant="minimal" icon="right-arrow">
            {tryTool[locale]}
          </LinkButton>
        )}
      </Card>
    );
  })}
</CardGrid>
