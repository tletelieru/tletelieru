---
import { toolPath, toolsByCategory, withBase } from '~/lib/tools/registry';

const groups = toolsByCategory();
const base = import.meta.env.BASE_URL;
---

{groups.map(({ category, tools }) => (
  <section class="tool-index-category">
    <h2 id={category.id}>{category.label}</h2>
    <ul class="tool-index-list">
      {tools.map((tool) => (
        <li>
          <a href={withBase(base, toolPath(tool))}>{tool.name}</a>
          <p>{tool.description}</p>
        </li>
      ))}
    </ul>
  </section>
))}
