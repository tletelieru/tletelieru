---
import FeatureIsland from './features/FeatureIsland';
import { featureModules } from './features/features';
import { toLocale } from '~/i18n/locales';

interface Props {
  name: string;
}

const { name } = Astro.props;
await featureModules.preload(name);
const locale = toLocale(Astro.locals.starlightRoute.locale);
---

<div class="tool-embed">
  <FeatureIsland client:load name={name} locale={locale} />
</div>
