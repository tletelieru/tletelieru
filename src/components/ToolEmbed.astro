---
import ToolIsland from './tools/ToolIsland';
import { toLocale } from '~/i18n/locales';
import { getTool } from '~/lib/tools/registry';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const tool = getTool(slug);
if (!tool) throw new Error(`ToolEmbed: unknown tool "${slug}"`);
const locale = toLocale(Astro.locals.starlightRoute.locale);
const labels = {
  en: { loading: 'Loading', keywords: 'Keywords' },
  es: { loading: 'Cargando', keywords: 'Palabras clave' },
}[locale];
---

<div class="tool-embed" data-tool-slug={slug}>
  <ToolIsland client:only="react" slug={slug} locale={locale}>
    <p slot="fallback" class="tool-loading">
      {labels.loading}
      {tool.name[locale]}…
    </p>
  </ToolIsland>
</div>
<p class="tool-keywords">
  {labels.keywords}: {tool.keywords.join(', ')}
</p>

<script>
  import { recordVisit } from '~/lib/user-data/recent';

  for (const element of document.querySelectorAll<HTMLElement>('[data-tool-slug]')) {
    if (element.dataset.toolSlug) recordVisit(element.dataset.toolSlug);
  }
</script>
