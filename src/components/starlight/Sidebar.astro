---
import Default from '@astrojs/starlight/components/Sidebar.astro';
import { Icon } from '@astrojs/starlight/components';
import { toLocale } from '~/i18n/locales';
import { STORE_CHANGE_EVENT } from '~/lib/storage';
import { toolPath, tools, withBase } from '~/lib/tools/registry';
import { favoritesStore } from '~/lib/user-data/favorites';
import { recentStore, RECENT_LIMIT } from '~/lib/user-data/recent';
import shortcutsSource from '~/lib/sidebar-shortcuts.inline.js?raw';

const locale = toLocale(Astro.locals.starlightRoute.locale);
const labels = {
  en: {
    collapse: 'Collapse sidebar',
    expand: 'Expand sidebar',
    shortcuts: 'Favorites and recent tools',
    favorites: 'Favorites',
    recent: 'Recent',
    clear: 'Clear',
    clearRecent: 'Clear recent',
  },
  es: {
    collapse: 'Contraer barra lateral',
    expand: 'Expandir barra lateral',
    shortcuts: 'Herramientas favoritas y recientes',
    favorites: 'Favoritos',
    recent: 'Recientes',
    clear: 'Borrar',
    clearRecent: 'Borrar recientes',
  },
}[locale];

const base = import.meta.env.BASE_URL;
const shortcutsConfig = {
  index: Object.fromEntries(
    tools.map((tool) => [
      tool.slug,
      { name: tool.name[locale], href: withBase(base, toolPath(tool, locale)) },
    ]),
  ),
  labels: {
    favorites: labels.favorites,
    recent: labels.recent,
    clear: labels.clear,
    clearRecent: labels.clearRecent,
  },
  limit: RECENT_LIMIT,
  favoritesKey: favoritesStore.key,
  recentKey: recentStore.key,
  sectionsKey: 'tl:sidebar-sections',
  event: STORE_CHANGE_EVENT,
};
const shortcutsScript = `(${shortcutsSource.replace(/^export\s+/m, '').trim()})(document.getElementById('tl-sidebar-shortcuts'), ${JSON.stringify(shortcutsConfig).replace(/</g, '\\u003c')});`;
---

<button
  type="button"
  class="sidebar-toggle"
  aria-controls="starlight__sidebar"
  aria-expanded="true"
  aria-label={labels.collapse}
  title={labels.collapse}
  data-label-collapse={labels.collapse}
  data-label-expand={labels.expand}
>
  <Icon name="left-caret" size="1.25rem" />
</button>
<nav id="tl-sidebar-shortcuts" class="sidebar-shortcuts" aria-label={labels.shortcuts} hidden></nav>
<script is:inline set:html={shortcutsScript} />
<Default>
  <slot />
</Default>

<script>
  import { saveSidebarScroll } from '~/lib/sidebar-scroll';

  const scroller = document.getElementById('starlight__sidebar');
  scroller?.addEventListener('click', (event) => {
    if (event.target instanceof Element && event.target.closest('a[href]')) {
      saveSidebarScroll(scroller);
    }
  });
  window.addEventListener('pagehide', () => {
    if (scroller) saveSidebarScroll(scroller);
  });
</script>

<script>
  const STORAGE_KEY = 'sl-sidebar-collapsed';
  const root = document.documentElement;

  function syncButton(button: HTMLButtonElement) {
    const collapsed = root.hasAttribute('data-sidebar-collapsed');
    const label = collapsed ? button.dataset.labelExpand : button.dataset.labelCollapse;
    button.setAttribute('aria-expanded', String(!collapsed));
    button.setAttribute('aria-label', label ?? '');
    button.title = label ?? '';
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>('.sidebar-toggle')) {
    syncButton(button);
    button.addEventListener('click', () => {
      const collapsed = root.toggleAttribute('data-sidebar-collapsed');
      syncButton(button);
      try {
        localStorage.setItem(STORAGE_KEY, collapsed ? '1' : '0');
      } catch {
        return;
      }
    });
  }
</script>
