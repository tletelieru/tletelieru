---
import Default from '@astrojs/starlight/components/Head.astro';
import { pwaInfo } from 'virtual:pwa-info';
import { preferredLocaleKey, toLocale } from '~/i18n/locales';
import { GOATCOUNTER_ENDPOINT } from '~/lib/analytics';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const locale = toLocale(Astro.locals.starlightRoute.locale);
---

<Default>
  <slot />
</Default>
<script is:inline define:vars={{ locale, preferredLocaleKey }}>
  try {
    localStorage.setItem(preferredLocaleKey, locale);
    if (localStorage.getItem('sl-sidebar-collapsed') === '1') {
      document.documentElement.setAttribute('data-sidebar-collapsed', '');
    }
    if (localStorage.getItem('tl:navbar-position') === 'bottom') {
      document.documentElement.dataset.navbar = 'bottom';
    }
  } catch {
    document.documentElement.removeAttribute('data-sidebar-collapsed');
  }
</script>
<link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
<meta name="theme-color" content="#17181c" />
{pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
<script src="../../pwa.ts"></script>
<script
  is:inline
  data-goatcounter={GOATCOUNTER_ENDPOINT}
  async
  src="https://gc.zgo.at/count.js"
></script>
